<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:layout_margin="12dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvBestSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBestLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- ZAROORI: MapV4Fragment.java is id ko use karta hai, delete na karein -->
        <TextView
            android:id="@+id/tvBestDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_reading_yet"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnNavigateBest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_mint"
                app:backgroundTint="@null"
                android:text="@string/go_to_best"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenMap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_dark"
                app:backgroundTint="@null"
                android:text="@string/open_in_maps"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/osmMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp" />
</LinearLayout>
