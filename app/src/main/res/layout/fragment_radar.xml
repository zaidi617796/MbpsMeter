<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/radar_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- Radar card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:layout_marginTop="12dp"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvRadarDbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#8A9ABF"
                    android:textSize="72sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dBm"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRadarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:text="—"
                android:textColor="#8A9ABF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="6dp" />

            <ProgressBar
                android:id="@+id/radarMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:max="100"
                android:progress="0"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvRadarTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#8A9ABF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvRadarOp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvRadarBest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radar_best_none"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Start/Stop + Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnRadarToggle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill_mint"
                app:backgroundTint="@null"
                android:text="@string/stop"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRadarSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_pill_dark"
                app:backgroundTint="@null"
                android:text="@string/radar_save_spot"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Sound / Buzz toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnRadarSound"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_dark"
                app:backgroundTint="@null"
                android:text="@string/radar_sound_on"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRadarVib"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_pill_dark"
                app:backgroundTint="@null"
                android:text="@string/radar_vib_on"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/radar_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
