<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sketch_title"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <!-- Mode toggle: Draw | Walk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnModeDraw"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_gradient_btn"
            app:backgroundTint="@null"
            android:text="@string/sketch_draw"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnModeWalk"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/sketch_walk"
            android:textColor="#8A9ABF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDrawHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sketch_draw_hint"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Sketch canvas -->
    <com.mbpsmeter.app.ui.sketch.SketchView
        android:id="@+id/sketchView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#0A1433" />

    <!-- Draw toolbar -->
    <HorizontalScrollView
        android:id="@+id/drawToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWall"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_gradient_btn"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_wall"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRoom"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_room"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnErase"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_erase"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_undo"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_clear"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_gradient_btn"
            app:backgroundTint="@null"
                android:minWidth="80dp"
                android:text="@string/sketch_save"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Walk panel -->
    <LinearLayout
        android:id="@+id/walkPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvWalkHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sketch_walk_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnWalkStart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/sketch_walk_start"
            android:textColor="#8A9ABF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Signal Radar — indoor best-spot finder -->
    <Button
        android:id="@+id/btnRadarNaksha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_btn"
            app:backgroundTint="@null"
        android:text="@string/open_radar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
