<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Theme -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/theme_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <RadioGroup
            android:id="@+id/rgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/rbDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_light"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rbAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_auto"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:padding="8dp" />
        </RadioGroup>

        <!-- Language -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lang_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnglish"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:text="English"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUrdu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:text="اردو"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSindhi"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:text="سنڌي"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPashto"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_cyan"
                    android:text="پښتو"
                    android:textAllCaps="false"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPunjabi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_cyan"
                android:text="پنجابی"
                android:textAllCaps="false"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- User guide -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/user_guide_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <Button
            android:id="@+id/btnGuide"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:text="@string/user_guide_title"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:drawableStart="@drawable/ic_arrow_up"
            android:drawablePadding="10dp" />

        <!-- Delete history (selective) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/delete_history_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <CheckBox
                android:id="@+id/cbDelSignals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/del_signals"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:checked="true"
                android:padding="6dp" />

            <CheckBox
                android:id="@+id/cbDelSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/del_speed"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:checked="true"
                android:padding="6dp" />

            <CheckBox
                android:id="@+id/cbDelDrops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/del_drops"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:checked="true"
                android:padding="6dp" />

            <CheckBox
                android:id="@+id/cbDelSketch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/del_sketch"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:checked="false"
                android:padding="6dp" />

            <Button
                android:id="@+id/btnDeleteHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_red"
                android:text="@string/delete_selected"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/about_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/bg_card"
            android:padding="16dp"
            android:text="@string/about_text"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
