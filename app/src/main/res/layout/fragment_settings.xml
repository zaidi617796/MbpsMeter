<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ===== Theme ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="22dp"
            android:text="@string/theme_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="36dp"
                    android:background="@color/glass_border" />

                <RadioButton
                    android:id="@+id/rbLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/theme_light"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="36dp"
                    android:background="@color/glass_border" />

                <RadioButton
                    android:id="@+id/rbAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/theme_auto"
                    android:textColor="@color/text_main"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== Language ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="22dp"
            android:text="@string/lang_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnglish"
                    style="@style/SettingsLangButton"
                    app:backgroundTint="@null"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="English" />

                <Button
                    android:id="@+id/btnUrdu"
                    style="@style/SettingsLangButton"
                    app:backgroundTint="@null"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:text="اردو" />

                <Button
                    android:id="@+id/btnSindhi"
                    style="@style/SettingsLangButton"
                    app:backgroundTint="@null"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:text="سنڌي" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPashto"
                    style="@style/SettingsLangButton"
                    app:backgroundTint="@null"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:text="پښتو" />

                <Button
                    android:id="@+id/btnPunjabi"
                    style="@style/SettingsLangButton"
                    app:backgroundTint="@null"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:text="پنجابی" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== User guide ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="22dp"
            android:text="@string/user_guide_title" />

        <Button
            android:id="@+id/btnGuide"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glass"
            app:backgroundTint="@null"
            android:gravity="center_vertical|start"
            android:paddingStart="18dp"
            android:text="@string/user_guide_title"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <!-- ===== Delete history ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="22dp"
            android:text="@string/delete_history_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/cbDelSignals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/del_signals"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbDelSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/del_speed"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbDelDrops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/del_drops"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbDelSketch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/del_sketch"
                android:textColor="@color/text_main"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/glass_border" />

            <Button
                android:id="@+id/btnDeleteHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_red"
                app:backgroundTint="@null"
                android:text="@string/delete_selected"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== About ===== -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:layout_marginTop="22dp"
            android:text="@string/about_title" />

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_glass"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:padding="16dp"
            android:text="@string/about_text"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <!-- Diagnostic: sirf tab dikhta hai jab koi purana error save ho (Java on karta hai) -->
        <Button
            android:id="@+id/btnLastError"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="⚠️ Last Error Dekho"
            android:textAllCaps="false"
            android:textColor="@color/warn"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
