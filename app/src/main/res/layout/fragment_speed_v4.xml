<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_title"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tvMainSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mbps"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStartSpeed"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_neon_ring"
            app:backgroundTint="@null"
            android:text="GO"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#00E5FF" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tap_go"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <!-- Best / worst hour pattern -->
        <TextView
            android:id="@+id/tvPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:text="@string/speed_pattern_none"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp" />

        <!-- Download / Upload cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:background="@drawable/bg_card_glass"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="--"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="92dp"
                android:background="@drawable/bg_card_glass"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upload"
                    android:textColor="#7C4DFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="--"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ping / Jitter cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="78dp"
                android:background="@drawable/bg_card_glass"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ping"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="78dp"
                android:background="@drawable/bg_card_glass"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jitter"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJitter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--"
                    android:textColor="@color/text_main"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/speed_tip"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:gravity="center" />

        <!-- Is speed par kya chalega (Meteor-style estimator) -->
        <TextView
            android:id="@+id/tvWorks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnShareSpeed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/share_result"
            android:textAllCaps="false"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:drawableStart="@android:drawable/ic_menu_share"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
