<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card" android:orientation="horizontal"
    android:padding="14dp" android:layout_marginBottom="10dp">
    <TextView android:id="@+id/badgeDbm" android:layout_width="90dp" android:layout_height="36dp"
        android:background="#7CFF8A" android:gravity="center" android:text="-81 dBm" android:textColor="#070E2B" android:textStyle="bold"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Strong Signal" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/tvLoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24.8469, 66.9842" android:textColor="#8A9ABF" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>