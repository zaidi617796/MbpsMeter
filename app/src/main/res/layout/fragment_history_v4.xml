<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_dark"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="@string/export_csv"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_dark"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/clear_history"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Readings / Drops toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnTabReadings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_mint"
            app:backgroundTint="@null"
            android:text="@string/tab_readings"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTabDrops"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/tab_drops"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

    <!-- Cloud backup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCloudBackup"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/cloud_backup"
            android:textAllCaps="false"
            android:textColor="#00E5FF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCloudRestore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:text="@string/cloud_restore"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp" />
</LinearLayout>
